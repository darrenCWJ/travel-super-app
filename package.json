{
  "name": "travel-super-app",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node tools/registry-gen/cli.mjs",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @tsa/web --fail-if-no-match dev",
    "build": "pnpm --filter @tsa/web --fail-if-no-match build",
    "test": "pnpm -r --stream test",
    "test:e2e": "pnpm --filter @tsa/web --fail-if-no-match test:e2e"
  }
}
